(module
  (type $value (func (result i32)))
  (table 1 funcref)
  (elem declare func $forty_two $fifty_seven $apply)
  (func $forty_two (result i32) (i32.const 42))
  (func $fifty_seven (result i32) (i32.const 57))
  (func $apply (export "apply") (param $ref funcref) (result i32)
    (table.set (i32.const 0) (local.get $ref))
    (call_indirect (type $value) (i32.const 0)))
  (func (export "reference0") (result funcref) (ref.func $forty_two))
  (func (export "reference1") (result funcref) (ref.func $fifty_seven))
  (func $identity (export "identity") (param $ref funcref) (result funcref)
    (local.get $ref))
  (func (export "external_identity") (param externref) (result externref)
    (local.get 0))
  (func (export "_start")
    (if (i32.ne (call $apply (ref.func $forty_two)) (i32.const 42)) (then unreachable))
    (if (i32.ne (call $apply (ref.func $fifty_seven)) (i32.const 57)) (then unreachable))
    (if (ref.is_null (call $identity (ref.func $forty_two))) (then unreachable))
    (if (i32.eqz (ref.is_null (call $identity (ref.null func)))) (then unreachable)))
)

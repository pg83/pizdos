(module
  (func $mix (param $a i32) (param $b i32) (param $c i32) (result i32)
    (i32.xor (i32.rotl (local.get $a) (i32.const 5))
      (i32.mul (i32.add (local.get $b) (local.get $c)) (i32.const 33))))
  ;; Conditional copies, calls and rotations retain 24 seed-dependent
  ;; values across the loop. Include an empty structured join as well.
  (func $diamonds (param $seed i32) (param $selector i32) (param $rounds i32) (result i32)
    (local $x0 i32)
    (local $x1 i32)
    (local $x2 i32)
    (local $x3 i32)
    (local $x4 i32)
    (local $x5 i32)
    (local $x6 i32)
    (local $x7 i32)
    (local $x8 i32)
    (local $x9 i32)
    (local $x10 i32)
    (local $x11 i32)
    (local $x12 i32)
    (local $x13 i32)
    (local $x14 i32)
    (local $x15 i32)
    (local $x16 i32)
    (local $x17 i32)
    (local $x18 i32)
    (local $x19 i32)
    (local $x20 i32)
    (local $x21 i32)
    (local $x22 i32)
    (local $x23 i32)
    (local $hash i32)
    (local.set $x0 (i32.xor (local.get $seed) (i32.const 2654435761)))
    (local.set $x1 (i32.xor (local.get $seed) (i32.const 1013904226)))
    (local.set $x2 (i32.xor (local.get $seed) (i32.const 3668339987)))
    (local.set $x3 (i32.xor (local.get $seed) (i32.const 2027808452)))
    (local.set $x4 (i32.xor (local.get $seed) (i32.const 387276917)))
    (local.set $x5 (i32.xor (local.get $seed) (i32.const 3041712678)))
    (local.set $x6 (i32.xor (local.get $seed) (i32.const 1401181143)))
    (local.set $x7 (i32.xor (local.get $seed) (i32.const 4055616904)))
    (local.set $x8 (i32.xor (local.get $seed) (i32.const 2415085369)))
    (local.set $x9 (i32.xor (local.get $seed) (i32.const 774553834)))
    (local.set $x10 (i32.xor (local.get $seed) (i32.const 3428989595)))
    (local.set $x11 (i32.xor (local.get $seed) (i32.const 1788458060)))
    (local.set $x12 (i32.xor (local.get $seed) (i32.const 147926525)))
    (local.set $x13 (i32.xor (local.get $seed) (i32.const 2802362286)))
    (local.set $x14 (i32.xor (local.get $seed) (i32.const 1161830751)))
    (local.set $x15 (i32.xor (local.get $seed) (i32.const 3816266512)))
    (local.set $x16 (i32.xor (local.get $seed) (i32.const 2175734977)))
    (local.set $x17 (i32.xor (local.get $seed) (i32.const 535203442)))
    (local.set $x18 (i32.xor (local.get $seed) (i32.const 3189639203)))
    (local.set $x19 (i32.xor (local.get $seed) (i32.const 1549107668)))
    (local.set $x20 (i32.xor (local.get $seed) (i32.const 4203543429)))
    (local.set $x21 (i32.xor (local.get $seed) (i32.const 2563011894)))
    (local.set $x22 (i32.xor (local.get $seed) (i32.const 922480359)))
    (local.set $x23 (i32.xor (local.get $seed) (i32.const 3576916120)))
    (block $done
      (br_if $done (i32.eqz (local.get $rounds)))
      (loop $again
        (if (i32.and (i32.xor (local.get $selector) (local.get $x22)) (i32.const 2))
          (then
            (local.set $x5 (select (local.get $x8) (local.get $x3) (i32.and (local.get $x11) (i32.const 1))))
          )
          (else
            (local.set $x9 (i32.sub (local.get $x2) (local.get $x5)))
            (local.set $x12 (select (local.get $x11) (local.get $x20) (i32.and (local.get $x6) (i32.const 1))))
            (local.set $x13 (select (local.get $x22) (local.get $x3) (i32.and (local.get $x4) (i32.const 1))))
          ))
        (if (i32.and (i32.xor (local.get $selector) (local.get $x21)) (i32.const 536870912))
          (then
            (local.set $x0 (call $mix (local.get $x10) (local.get $x16) (local.get $x10)))
            (local.set $x14 (select (local.get $x23) (local.get $x4) (i32.and (local.get $x6) (i32.const 1))))
            (local.set $x6 (i32.sub (local.get $x11) (local.get $x5)))
            (local.set $x22 (call $mix (local.get $x21) (local.get $x15) (local.get $x21)))
            (local.set $x5 (i32.rotl (local.get $x23) (local.get $x6)))
            (local.set $x9 (i32.add (local.get $x9) (local.get $x11)))
          )
          (else
            (local.set $x0 (i32.sub (local.get $x12) (local.get $x8)))
            (local.set $x1 (i32.sub (local.get $x6) (local.get $x17)))
            (local.set $x6 (i32.rotl (local.get $x1) (local.get $x15)))
          ))
        (if (i32.and (i32.xor (local.get $selector) (local.get $x23)) (i32.const 64))
          (then)
          (else))
        (local.set $rounds (i32.sub (local.get $rounds) (i32.const 1)))
        (br_if $again (local.get $rounds))))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x0)))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x1)))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x2)))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x3)))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x4)))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x5)))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x6)))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x7)))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x8)))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x9)))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x10)))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x11)))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x12)))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x13)))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x14)))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x15)))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x16)))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x17)))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x18)))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x19)))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x20)))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x21)))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x22)))
    (local.set $hash (i32.xor (i32.rotl (local.get $hash) (i32.const 3)) (local.get $x23)))
    (local.get $hash))
)
